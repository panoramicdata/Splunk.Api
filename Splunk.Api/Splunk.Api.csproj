<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<NeutralResourcesLanguage>en</NeutralResourcesLanguage>
		<!-- RF006: Refit's source generator falls back to the reflection request builder for some
		     signatures. SplunkClient creates its clients with RestService.For<T>(), which the diagnostic
		     permits; this library is not trimmed or AOT-published. -->
		<NoWarn>$(NoWarn);RF006</NoWarn>

		<PackageId>Splunk.Api</PackageId>
		<Owners>Panoramic Data Limited</Owners>
		<PackageProjectUrl>https://github.com/panoramicdata/Splunk.Api</PackageProjectUrl>
		<RepositoryUrl>https://github.com/panoramicdata/Splunk.Api</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageIcon>Icon.png</PackageIcon>
		<Description>A typed, modern .NET client for the Splunk Enterprise REST API (10.6): searches and search jobs, saved searches and alerts, knowledge objects, KV store, apps, access control, inputs, indexes, configuration, licensing, clustering and more.</Description>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageTags>Splunk;SplunkEnterprise;SIEM;REST;Search;SPL;KVStore;PanoramicData</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
		<PackageReference Include="Nerdbank.GitVersioning" PrivateAssets="all" />
		<PackageReference Include="Refit" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Icon.png" Pack="true" PackagePath="" />
		<None Include="..\README.md" Link="README.md" Pack="true" PackagePath="" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Splunk.Api.Test" />
	</ItemGroup>

</Project>
